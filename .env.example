# Live Show Radar — copy to .env.local for local development. PLACEHOLDERS ONLY.
# On Vercel: Project → Settings → Environment Variables (server-side; never NEXT_PUBLIC_ for secrets).

# Public URL of the app, no trailing slash. On Vercel it defaults to the production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres (set automatically on Vercel by the Supabase integration as POSTGRES_URL)
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_NON_POOLING=postgres://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Dashboard sign-in (single owner) — choose a strong password; SESSION_SECRET = 32+ random chars
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=generate-32-random-characters
# Bearer secret the scheduler sends to /api/monitor/run
CRON_SECRET=generate-32-random-characters

# Gemini (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Telegram (create with @BotFather; chat ID from Settings → "Check bot & find chat ID")
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=123456789

# Spotify (developer.spotify.com/dashboard) — local redirect must use 127.0.0.1, not localhost
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://<your-app>.vercel.app/api/spotify/callback

# Google Calendar (console.cloud.google.com → Web application OAuth client)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://<your-app>.vercel.app/api/google/callback

# Optional providers (adapters not enabled yet — see docs/INTEGRATIONS.md)
TICKETMASTER_API_KEY=
BANDSINTOWN_APP_ID=
